---
import { getTeamMembers } from "@lib/api";
import { Image } from "astro:assets";
import Layout from "@layouts/Layout.astro";
import FacebookIcon from "@icons/facebook.svg";
import InstagramIcon from "@icons/instagram.svg";
import Button from "../../components/Button.astro";

export async function getStaticPaths() {
  const team = await getTeamMembers();

  return team.map((employee) => ({
    params: { slug: employee.slug },
    props: { employee },
  }));
}

const { employee } = Astro.props;
---

<Layout>
  <section class="member-page">
    <Button text="← Back to team" href="/team" />

    <div class="member-layout">
      <div class="member-image-column">
        <div class="green-shape"></div>

        <Image
          src={employee.image.src}
          alt={employee.image.alt}
          width={employee.image.width}
          height={employee.image.height}
          class="member-image"
        />

        {
          employee.social_links?.length > 0 && (
            <div class="socials">
              {employee.social_links.map((social) => (
                <a href={social.url} aria-label={social.platform}>
                  {social.platform === "instagram" && <InstagramIcon />}
                  {social.platform === "facebook" && <FacebookIcon />}
                </a>
              ))}
            </div>
          )
        }
      </div>

      <div class="member-content">
        <h1>{employee.name}</h1>

        <span class="member-title">{employee.title}</span>

        <p>{employee.description_long}</p>

        <hr />

        <h2>Past experience</h2>

        <p>{employee.past_experience}</p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .member-page {
    padding-block: var(--space-xl) var(--space-5xl);
  }

  .member-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5xl);
    max-width: 850px;
    margin: var(--space-3xl) auto 0;
  }

  .member-image-column {
    position: relative;
  }

  .green-shape {
    position: absolute;
    top: calc(var(--space-md) * -1);
    left: calc(var(--space-md) * -1);
    width: var(--space-6xl);
    height: var(--space-6xl);
    border-radius: var(--radius-sm);
    background: var(--color-ui-secondary);
  }

  .member-image {
    position: relative;
    z-index: 1;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius-sm);
  }

  .socials {
    display: flex;
    justify-content: center;
    gap: var(--space-sm);
    margin-top: var(--space-sm);
  }

  .socials a {
    display: flex;
    color: var(--color-text);
    text-decoration: none;
  }

  .socials svg {
    width: 30px;
    height: 30px;
  }

  .member-content h1 {
    font-family: var(--font-family-primary);
    font-size: var(--font-size-xl);
    font-weight: 600;
    line-height: var(--line-height-heading);
  }

  .member-title {
    display: block;
    margin-top: var(--space-xs);
    font-size: var(--font-size-sm);
  }

  .member-content p {
    margin-top: var(--space-lg);
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-body);
  }

  .member-content hr {
    margin-block: var(--space-lg);
    border: 0;
    border-top: 1px solid var(--color-neutrals-200);
  }

  .member-content h2 {
    font-family: var(--font-family-primary);
    font-size: var(--font-size-lg);
    font-weight: 600;
  }

  @media (max-width: 700px) {
    .member-layout {
      grid-template-columns: 1fr;
    }

    .member-image-column {
      max-width: 500px;
    }
  }
</style>
