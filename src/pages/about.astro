---
import Layout from "@layouts/Layout.astro";
import TeamCard from "../components/TeamCard.astro";
import FAQ from "../components/FAQ.astro";
import CoreValues from "../components/CoreValues.astro";

const response = await fetch("https://ftk-api.pages.dev/team");
const team = await response.json();

const sarah = team.find((employee) => employee.slug === "sarah-jasmine");
const john = team.find((employee) => employee.slug === "john-carter");
---

<Layout title="About Us">
  <section class="about-hero">
    <div class="hero-content">
      <span class="section-label">ABOUT</span>

      <h1>Igniting Innovation</h1>

      <div class="yellow-line"></div>

      <p>
        Our strength lies in the collaboration between our talented teams and
        esteemed clients. We cultivate a workplace that champions innovation,
        promotes peak performance, and guarantees client satisfaction.
      </p>
    </div>
  </section>

  <section class="vision-section">
    <div class="vision-content">
      <div class="vision-text">
        <span class="section-label">OUR VISION</span>

        <h2>Turn your ideas into reality.</h2>

        <p>
          Capitalize on how long trail to identify a bulk value added activity
          beta test. Override the digital slide with additional from DevOps.
        </p>

        <ul>
          <li>
            <span>✓</span>
            <p>
              Bring to the table with our unified strategies to ensure proactive
              domination, at the end of the day.
            </p>
          </li>

          <li>
            <span>✓</span>
            <p>
              Capitalize on how having tight to identify a bulk value added
              activity to best serve the strategy.
            </p>
          </li>
        </ul>
      </div>

      <div class="vision-image">
        <div class="green-shape"></div>

        <img
          src="/src/data/images/storyboard.webp"
          alt="Team members working together"
        />
      </div>
    </div>

    <div class="stats">
      <div>
        <strong>1128+</strong>
        <span>Successful Work</span>
      </div>

      <div>
        <strong>908+</strong>
        <span>Team member</span>
      </div>

      <div>
        <strong>258+</strong>
        <span>Happy Customers</span>
      </div>

      <div>
        <strong>564+</strong>
        <span>Creative Idea</span>
      </div>
    </div>
  </section>

  <CoreValues />

  <section class="team-preview">
    <div class="team-preview-grid">
      <div class="preview-intro">
        <span class="section-label">OUR TEAM</span>

        <h2>We champion<br />the bold</h2>

        <p>
          Our success stems from the synergy between dedicated teams and valued
          clients. We prioritize a company culture that fosters exceptional
          productivity.
        </p>

        <a href="/team" class="button">Meet the Team</a>
      </div>

      <div class="preview-members">
        {sarah && <TeamCard employee={sarah} />}
        {john && <TeamCard employee={john} />}
      </div>
    </div>
  </section>

  <FAQ />
</Layout>

<style>
  .section-label {
    display: block;
    color: var(--color-text-muted);
    font-family: var(--font-family-primary);
    font-size: var(--font-size-sm);
    font-weight: 600;
    letter-spacing: 0.13em;
  }

  .about-hero {
    background: var(--color-surface-secondary);
    text-align: center;
  }

  .hero-content {
    padding-block: var(--space-5xl);
  }

  .about-hero h1 {
    margin-top: var(--space-xs);
    font-family: var(--font-family-primary);
    font-size: var(--font-size-2xl);
    font-weight: 600;
  }

  .yellow-line {
    width: 100%;
    height: 3px;
    margin-top: var(--space-md);
    background: var(--color-action);
  }

  .about-hero p {
    max-width: 540px;
    margin: var(--space-lg) auto 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-body);
  }

  .vision-section {
    padding-block: var(--space-5xl);
  }

  .vision-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5xl);
    align-items: center;
  }

  .vision-text h2 {
    margin-block: var(--space-xs) var(--space-sm);
    font-family: var(--font-family-primary);
    font-size: var(--font-size-lg);
    font-weight: 600;
  }

  .vision-text > p {
    max-width: 430px;
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-body);
  }

  .vision-text ul {
    display: grid;
    gap: var(--space-sm);
    margin-top: var(--space-md);
    padding: 0;
    list-style: none;
  }

  .vision-text li {
    display: flex;
    gap: var(--space-xs);
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-body);
  }

  .vision-text li span {
    color: var(--color-green-600);
    font-weight: 700;
  }

  .vision-text li p {
    margin: 0;
  }

  .vision-image {
    position: relative;
  }

  .green-shape {
    position: absolute;
    top: calc(var(--space-xs) * -1);
    right: calc(var(--space-xs) * -1);
    width: 100px;
    height: 100px;
    border-radius: var(--radius-sm);
    background: var(--color-ui-secondary);
  }

  .vision-image img {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    aspect-ratio: 1.4;
    object-fit: cover;
    border-radius: var(--radius-sm);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
    max-width: 750px;
    margin: var(--space-3xl) auto 0;
    text-align: center;
  }

  .stats strong {
    display: block;
    font-family: var(--font-family-primary);
    font-size: var(--font-size-lg);
    font-weight: 600;
  }

  .stats span {
    display: block;
    margin-top: var(--space-xs);
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  .team-preview {
    padding-block: var(--space-5xl);
  }

  .team-preview-grid {
    display: grid;
    grid-template-columns: 0.7fr 1.3fr;
    gap: var(--space-4xl);
    align-items: center;
  }

  .preview-intro h2 {
    margin-block: var(--space-xs) var(--space-sm);
    font-family: var(--font-family-primary);
    font-size: var(--font-size-xl);
    font-weight: 600;
    line-height: var(--line-height-heading);
  }

  .preview-intro p {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-body);
  }

  .button {
    display: inline-block;
    margin-top: var(--space-md);
    padding: var(--space-xs) var(--space-lg);
    border-radius: var(--radius-pill);
    background: var(--color-ui-primary);
    color: var(--color-on-ui-primary);
    font-size: var(--font-size-sm);
    text-decoration: none;
  }

  .preview-members {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }

  @media (max-width: 800px) {
    .vision-content {
      grid-template-columns: 1fr;
    }

    .vision-image {
      max-width: 500px;
      margin-inline: auto;
    }

    .team-preview-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .stats {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-xl);
    }
  }

  @media (max-width: 450px) {
    .preview-members {
      grid-template-columns: 1fr;
    }
  }
</style>
