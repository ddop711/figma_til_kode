---
//@ts-nocheck
import ServiceCard from "@components/ServiceCard.astro";

const serviceData = await fetch("https://ftk-api.pages.dev/services").then(
  (res) => res.json(),
);
---

<div class="services">
  {serviceData.map((service) => <ServiceCard service={service} />)}
</div>

<style>
  @layer components {
    .services {
      display: grid;
      gap: var(--space-md);
      grid-template-columns: 1fr;
    }

    @media (min-width: 900px) {
      .services {
        grid-template-columns: repeat(3, 1fr);
        gap: var(--space-xl);
      }
    }
  }
</style>
