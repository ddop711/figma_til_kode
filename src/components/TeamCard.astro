---
const { employee } = Astro.props;
---

<article class="team-card">
  <a href={`/team/${employee.slug}`} class="team-link">
    <div class="team-image">
      <img src={employee.image.src} alt={employee.image.alt} />

      <span>{employee.title}</span>
    </div>

    <div class="team-info">
      <h2>{employee.name}</h2>

      <p>{employee.description}</p>
    </div>
  </a>

  {
    employee.social_links?.length > 0 && (
      <div class="team-socials">
        {employee.social_links.map((social) => (
          <a href={social.url} aria-label={social.platform}>
            {social.platform}
          </a>
        ))}
      </div>
    )
  }
</article>

<style>
  .team-card {
    min-width: 0;
  }

  .team-link {
    display: block;
    color: var(--color-text);
    text-decoration: none;
  }

  .team-image {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--color-surface-tertiary);
  }

  .team-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .team-image span {
    position: absolute;
    right: var(--space-xs);
    bottom: var(--space-xs);

    padding: var(--space-xs) var(--space-sm);

    border-radius: var(--radius-pill);

    background: var(--color-ui-primary);
    color: var(--color-on-ui-primary);

    font-size: var(--font-size-sm);
  }

  .team-info h2 {
    margin-top: var(--space-sm);

    font-family: var(--font-family-primary);
    font-size: var(--font-size-md);
    font-weight: 600;
  }

  .team-info p {
    margin-top: var(--space-xs);

    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-body);
  }

  .team-socials {
    display: flex;
    justify-content: center;
    gap: var(--space-sm);

    margin-top: var(--space-sm);
  }

  .team-socials a {
    color: var(--color-text);
    font-size: var(--font-size-sm);
    text-decoration: none;
  }
</style>
