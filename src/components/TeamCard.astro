---
import FacebookIcon from "@icons/facebook.svg";
import InstagramIcon from "@icons/instagram.svg";

const { employee } = Astro.props;
---

<article class="team-card">
  <div class="team-card-inner">
    <a href={`/team/${employee.slug}`} class="team-link">
      <div class="team-image">
        <img src={employee.image.src} alt={employee.image.alt} />
        <span>{employee.title}</span>
      </div>

      <div class="team-info">
        <h2>{employee.name}</h2>
        <p>{employee.description}</p>
      </div>
    </a>

    {
      employee.social_links?.length > 0 && (
        <div class="team-socials">
          {employee.social_links.map((social) => (
            <a href={social.url} aria-label={social.platform}>
              {social.platform === "instagram" && <InstagramIcon />}
              {social.platform === "facebook" && <FacebookIcon />}
            </a>
          ))}
        </div>
      )
    }
  </div>
</article>

<style>
  .team-card {
    container-type: inline-size;
    container-name: team-card;
    min-width: 0;
  }

  .team-card-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    height: 100%;
  }

  .team-link {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    color: var(--color-text);
    text-decoration: none;
  }

  .team-image {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--color-surface-tertiary);
  }

  .team-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .team-image span {
    position: absolute;
    right: var(--space-xs);
    bottom: var(--space-xs);
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-pill);
    background: var(--color-ui-primary);
    color: var(--color-on-ui-primary);
    font-size: var(--font-size-sm);
  }

  .team-info {
    text-align: center;
  }

  .team-info h2 {
    font-family: var(--font-family-primary);
    font-size: var(--font-size-md);
    font-weight: 600;
  }

  .team-info p {
    margin-top: var(--space-xs);
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-body);
  }

  .team-socials {
    display: flex;
    justify-content: center;
    gap: var(--space-sm);
    margin-top: auto;
  }

  .team-socials a {
    display: flex;
    color: var(--color-text);
    text-decoration: none;
  }

  .team-socials svg {
    width: 30px;
    height: 30px;
  }

  
  @container team-card (min-width: 440px) {
    .team-card-inner {
      display: grid;
      grid-template-columns: 180px 1fr;
      grid-template-rows: 1fr auto;
      column-gap: var(--space-lg);
      align-items: center;
    }

    .team-link {
      display: contents;
    }

    .team-image {
      grid-row: 1 / -1;
    }

    .team-info {
      text-align: left;
      align-self: end;
    }

    .team-socials {
      justify-content: flex-start;
      align-self: start;
      margin-top: var(--space-xs);
    }
  }
</style>