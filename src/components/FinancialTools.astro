---
import ArrowLeft from "@icons/arrow-left.svg";
import ArrowRight from "@icons/arrow--right.svg";
import CalIcon from "@icons/cal.svg";
import CardIcon from "@icons/card.svg";
import LawIcon from "@icons/law.svg";
import MoneyIcon from "@icons/money.svg";

const icons: Record<string, any> = {
  cal: CalIcon,
  card: CardIcon,
  law: LawIcon,
  money: MoneyIcon,
};

const response = await fetch("https://ftk-api.pages.dev/financial-projections");
const data = await response.json();
---

<section class="tools">
  <div class="header">
    <div class="text">
      <span>{data.eyebrow}</span>
      <h2>{data.title}</h2>
      <p>{data.subtitle}</p>
    </div>

    <div class="buttons">
      <button type="button" class="btn-prev" aria-label="Forrige">
        <ArrowLeft width={20} height={20} />
      </button>
      <button type="button" class="btn-next" aria-label="Næste">
        <ArrowRight width={20} height={20} />
      </button>
    </div>
  </div>

  <div class="cards">
    {
      data.values.map((item: any) => {
        const Icon = icons[item.icon] || MoneyIcon;
        return (
          <article class="card">
            <Icon width={32} height={32} />
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </article>
        );
      })
    }
  </div>
</section>

<script>
  const cards = document.querySelector(".tools .cards");
  const prevBtn = document.querySelector(".tools .btn-prev");
  const nextBtn = document.querySelector(".tools .btn-next");

  const getStep = () => {
    const card = cards?.querySelector(".card") as HTMLElement | null;
    return card ? card.offsetWidth + 24 : 340;
  };

  prevBtn?.addEventListener("click", () =>
    cards?.scrollBy({ left: -getStep(), behavior: "smooth" }),
  );
  nextBtn?.addEventListener("click", () =>
    cards?.scrollBy({ left: getStep(), behavior: "smooth" }),
  );
</script>

<style>
  .tools {
    background-color: var(--color-surface-secondary);
    color: var(--color-text);
    padding-block: var(--space-4xl);
    overflow-x: clip;

    @media (min-width: 1024px) {
      padding-block: var(--space-6xl);
    }

    .header {
      display: flex;
      flex-direction: column;
      gap: var(--space-lg);
      margin-bottom: var(--space-2xl);

      @media (min-width: 1024px) {
        flex-direction: row;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: var(--space-4xl);
      }

      .text {
        max-width: 600px;

        span {
          display: block;
          color: var(--color-ui-primary);
          font-size: var(--font-size-sm);
          letter-spacing: 2px;
          font-weight: 700;
          text-transform: uppercase;
          margin-bottom: var(--space-xs);
        }

        h2 {
          font-size: var(--font-size-xl);
          font-family: var(--font-family-primary);
          font-weight: 700;
          line-height: var(--line-height-heading);
          margin-bottom: var(--space-sm);
        }

        p {
          font-size: var(--font-size-base);
          color: var(--color-text-muted);
          line-height: var(--line-height-body);
        }
      }

      .buttons {
        display: flex;
        gap: var(--space-md);

        button {
          display: flex;
          align-items: center;
          justify-content: center;
          width: 48px;
          height: 48px;
          border: none;
          border-radius: var(--radius-pill);
          background-color: var(--color-ui-primary);
          color: var(--color-surface-primary);
          cursor: pointer;
          transition:
            opacity 0.2s ease,
            transform 0.1s ease;

          &:hover {
            opacity: 0.9;
          }

          &:active {
            transform: scale(0.95);
          }
        }
      }
    }

    .cards {
      display: flex;
      gap: var(--space-lg);
      overflow-x: auto;
      scroll-behavior: smooth;
      scroll-snap-type: x proximity;
      padding-bottom: var(--space-md);
      margin-right: calc(-50vw + 50%);
      padding-right: var(--space-2xl);
      scrollbar-width: none;

      &::-webkit-scrollbar {
        display: none;
      }

      @media (min-width: 1024px) {
        gap: var(--space-xl);
        padding-right: var(--space-4xl);
      }

      .card {
        flex: 0 0 290px;
        scroll-snap-align: start;
        background-color: var(--color-surface-tertiary);
        padding: var(--space-2xl);
        border-radius: var(--radius-md);

        @media (min-width: 600px) {
          flex: 0 0 320px;
        }

        svg {
          margin-bottom: var(--space-lg);
        }

        h3 {
          font-size: var(--font-size-md);
          font-family: var(--font-family-primary);
          font-weight: 700;
          line-height: var(--line-height-heading);
          margin-bottom: var(--space-xs);
        }

        p {
          font-size: var(--font-size-sm);
          color: var(--color-text-muted);
          line-height: var(--line-height-body);
        }
      }
    }
  }
</style>
