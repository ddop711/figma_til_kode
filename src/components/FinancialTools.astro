---
import ArrowLeft from "@icons/arrow-left.svg";
import ArrowRight from "@icons/arrow--right.svg";
import CalIcon from "@icons/cal.svg";
import CardIcon from "@icons/card.svg";
import LawIcon from "@icons/law.svg";
import MoneyIcon from "@icons/money.svg";

const response = await fetch("https://ftk-api.pages.dev/financial-projections");
const data = await response.json();
---

<section class="tools">
  <div class="container">
    <div class="header">
      <div class="text">
        <span>{data.eyebrow}</span>
        <h2>{data.title}</h2>
        <p>{data.subtitle}</p>
      </div>

      <div class="buttons">
        <button type="button" aria-label="Forrige">
          <ArrowLeft width={20} height={20} />
        </button>
        <button type="button" aria-label="Næste">
          <ArrowRight width={20} height={20} />
        </button>
      </div>
    </div>

    <div class="cards">
      <article class="card">
        <CalIcon width={32} height={32} />
        <h3>{data.values[0].title}</h3>
        <p>{data.values[0].description}</p>
      </article>

      <article class="card">
        <CardIcon width={32} height={32} />
        <h3>{data.values[1].title}</h3>
        <p>{data.values[1].description}</p>
      </article>

      <article class="card">
        <LawIcon width={32} height={32} />
        <h3>{data.values[2].title}</h3>
        <p>{data.values[2].description}</p>
      </article>

      <article class="card">
        <MoneyIcon width={32} height={32} />
        <h3>{data.values[3].title}</h3>
        <p>{data.values[3].description}</p>
      </article>
    </div>
  </div>
</section>

<style>
  .tools {
    padding: var(--space-4xl) var(--space-lg);
    background-color: var(--color-surface-secondary);
    color: var(--color-text);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .header {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    margin-bottom: var(--space-2xl);
  }

  .text span {
    display: block;
    color: var(--color-ui-primary);
    font-size: var(--font-size-sm);
    letter-spacing: 2px;
    font-weight: 700;
    text-transform: uppercase;
    margin-bottom: var(--space-xs);
  }

  .text h2 {
    font-size: var(--font-size-xl);
    font-family: var(--font-family-primary);
    font-weight: 700;
    line-height: var(--line-height-heading);
    margin-bottom: var(--space-sm);
  }

  .text p {
    font-size: var(--font-size-base);
    color: var(--color-text-muted);
    line-height: var(--line-height-body);
  }

  .buttons {
    display: flex;
    gap: var(--space-md);
  }

  .buttons button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border: none;
    border-radius: var(--radius-pill);
    background-color: var(--color-ui-primary);
    color: var(--color-surface-primary);
    cursor: pointer;
  }

  /* MOBIL: 1 KOLONNE */
  .cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  .card {
    background-color: var(--color-surface-tertiary);
    padding: var(--space-2xl);
    border-radius: var(--radius-md);
    box-sizing: border-box;
  }

  .card svg {
    margin-bottom: var(--space-lg);
  }

  .card h3 {
    font-size: var(--font-size-md);
    font-family: var(--font-family-primary);
    font-weight: 700;
    line-height: var(--line-height-heading);
    margin-bottom: var(--space-xs);
  }

  .card p {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    line-height: var(--line-height-body);
  }

  /* TABLET & DESKTOP */
  @media (min-width: 600px) {
    .cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .tools {
      padding: var(--space-6xl) var(--space-xl);
    }

    .header {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
      margin-bottom: var(--space-4xl);
    }

    .header .text {
      max-width: 600px;
    }

    .cards {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-xl);
    }
  }
</style>
