---
import ArrowLeft from "@icons/arrow-left.svg";
import ArrowRight from "@icons/arrow--right.svg";
import CalIcon from "@icons/cal.svg";
import CardIcon from "@icons/card.svg";
import LawIcon from "@icons/law.svg";
import MoneyIcon from "@icons/money.svg";

const response = await fetch("https://ftk-api.pages.dev/financial-projections");
const data = await response.json();
---

<section class="tools">
  <div class="container">
    <div class="header">
      <div class="text">
        <span>{data.eyebrow}</span>
        <h2>{data.title}</h2>
        <p>{data.subtitle}</p>
      </div>

      <div class="buttons">
        <button type="button" aria-label="Forrige">
          <ArrowLeft width={20} height={20} />
        </button>
        <button type="button" aria-label="Næste">
          <ArrowRight width={20} height={20} />
        </button>
      </div>
    </div>

    <div class="cards">
      <article class="card">
        <CalIcon width={32} height={32} />
        <h3>{data.values[0].title}</h3>
        <p>{data.values[0].description}</p>
      </article>

      <article class="card">
        <CardIcon width={32} height={32} />
        <h3>{data.values[1].title}</h3>
        <p>{data.values[1].description}</p>
      </article>

      <article class="card">
        <LawIcon width={32} height={32} />
        <h3>{data.values[2].title}</h3>
        <p>{data.values[2].description}</p>
      </article>

      <article class="card">
        <MoneyIcon width={32} height={32} />
        <h3>{data.values[3].title}</h3>
        <p>{data.values[3].description}</p>
      </article>
    </div>
  </div>
</section>

<style>
  .tools {
    background-color: var(--color-surface-secondary);
    color: var(--color-text);
    padding-block: var(--space-4xl);
    width: 100%;
    box-sizing: border-box;

    @media (min-width: 1024px) {
      padding-block: var(--space-6xl);
    }

    .container {
      width: 100%;

      .header {
        display: flex;
        flex-direction: column;
        gap: var(--space-lg);
        margin-bottom: var(--space-2xl);

        @media (min-width: 1024px) {
          flex-direction: row;
          justify-content: space-between;
          align-items: flex-end;
          margin-bottom: var(--space-4xl);
        }

        .text {
          @media (min-width: 1024px) {
            max-width: 600px;
          }

          span {
            display: block;
            color: var(--color-ui-primary);
            font-size: var(--font-size-sm);
            letter-spacing: 2px;
            font-weight: 700;
            text-transform: uppercase;
            margin-bottom: var(--space-xs);
          }

          h2 {
            font-size: var(--font-size-xl);
            font-family: var(--font-family-primary);
            font-weight: 700;
            line-height: var(--line-height-heading);
            margin-bottom: var(--space-sm);
          }

          p {
            font-size: var(--font-size-base);
            color: var(--color-text-muted);
            line-height: var(--line-height-body);
          }
        }

        .buttons {
          display: flex;
          gap: var(--space-md);

          button {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 48px;
            height: 48px;
            border: none;
            border-radius: var(--radius-pill);
            background-color: var(--color-ui-primary);
            color: var(--color-surface-primary);
            cursor: pointer;
          }
        }
      }

      .cards {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--space-lg);

        @media (min-width: 600px) {
          grid-template-columns: repeat(2, 1fr);
        }

        @media (min-width: 1024px) {
          grid-template-columns: repeat(4, 1fr);
          gap: var(--space-xl);
        }

        .card {
          background-color: var(--color-surface-tertiary);
          padding: var(--space-2xl);
          border-radius: var(--radius-md);
          box-sizing: border-box;

          svg {
            margin-bottom: var(--space-lg);
          }

          h3 {
            font-size: var(--font-size-md);
            font-family: var(--font-family-primary);
            font-weight: 700;
            line-height: var(--line-height-heading);
            margin-bottom: var(--space-xs);
          }

          p {
            font-size: var(--font-size-sm);
            color: var(--color-text-muted);
            line-height: var(--line-height-body);
          }
        }
      }
    }
  }
</style>
