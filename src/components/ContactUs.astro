---
// src/components/Contact.astro
import { Image } from "astro:assets";

import portraitImg from "../data/images/sarah.webp";
import teamImg from "../data/images/storyboard.webp";
import discussionImg from "../data/images/caseimg.webp";
---

<section class="contact">
  <div class="container">
    <div class="content">
      <span class="eyebrow">PROCESS</span>
      <h2>Contact Us. It's Easy.</h2>
      <p class="description">
        Leverage agile frameworks to provide a robust synopsis for high level
        overviews. Iterative approaches to corporate strategy foster
        collaborative.
      </p>

      <ul class="info-list">
        <li>
          <div class="icon-circle phone">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
              ></path>
            </svg>
          </div>
          <div class="text">
            <span class="label">Call Today</span>
            <span class="value">+1 800 100 900</span>
          </div>
        </li>

        <li>
          <div class="icon-circle clock">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </div>
          <div class="text">
            <span class="label">Monday To Friday</span>
            <span class="value">9AM - 5PM</span>
          </div>
        </li>

        <li>
          <div class="icon-circle location">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
          </div>
          <div class="text">
            <span class="label">USA Office</span>
            <span class="value">195 Devonshire St Boston, MA 02110</span>
          </div>
        </li>
      </ul>
    </div>

    <div class="visuals">
      <div class="green-shape"></div>
      <div class="image-grid">
        <Image src={portraitImg} alt="Consultant" class="img-tall" />
        <Image src={teamImg} alt="Team working" class="img-top" />
        <Image src={discussionImg} alt="Discussion" class="img-bottom" />
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    background-color: var(--color-surface-primary, #ffffff);
    padding-block: var(--space-5xl, 80px);
    padding-inline: var(--space-md, 16px);
    display: flex;
    justify-content: center;

    .container {
      display: flex;
      flex-direction: column;
      gap: var(--space-4xl, 48px);
      max-width: 1200px;
      width: 100%;

      /* Desktop layout */
      @media (min-width: 900px) {
        flex-direction: row;
        align-items: center;
        gap: var(--space-6xl, 80px);
      }

      .content {
        flex: 1;

        .eyebrow {
          color: var(--color-text, #181818);
          font-size: var(--font-size-sm, 14px);
          font-family: var(--font-family-secondary, sans-serif);
          letter-spacing: 2px;
          font-weight: 700;
          text-transform: uppercase;
          margin-bottom: var(--space-xs, 8px);
          display: block;
        }

        h2 {
          font-size: var(--font-size-xl, 36px);
          font-family: var(--font-family-primary, serif);
          line-height: 1.2;
          font-weight: 700;
          margin: 0 0 var(--space-md, 16px) 0;
          color: var(--color-text, #181818);

          @media (min-width: 900px) {
            font-size: var(--font-size-2xl, 42px);
          }
        }

        .description {
          color: var(--color-text-muted, #595566);
          font-size: var(--font-size-base, 16px);
          font-family: var(--font-family-secondary, sans-serif);
          line-height: 1.6;
          margin: 0 0 var(--space-2xl, 32px) 0;
          max-width: 480px;
        }

        .info-list {
          list-style: none;
          padding: 0;
          margin: 0;
          display: flex;
          flex-direction: column;
          gap: var(--space-lg, 24px);

          li {
            display: flex;
            align-items: center;
            gap: var(--space-md, 16px);

            .icon-circle {
              width: 48px;
              height: 48px;
              border-radius: 50%;
              display: flex;
              align-items: center;
              justify-content: center;
              flex-shrink: 0;

              &.phone {
                background-color: #fff3d4;
                color: #e5a800;
              }
              &.clock {
                background-color: #d1f5d3;
                color: #3b9f43;
              }
              &.location {
                background-color: #f2f2f2;
                color: #181818;
              }
            }

            .text {
              display: flex;
              flex-direction: column;
              gap: 2px;

              .label {
                color: var(--color-text-muted, #595566);
                font-size: 14px;
                font-family: var(--font-family-secondary, sans-serif);
              }

              .value {
                color: var(--color-text, #181818);
                font-size: 16px;
                font-family: var(--font-family-secondary, sans-serif);
                font-weight: 700;
              }
            }
          }
        }
      }

      .visuals {
        flex: 1;
        position: relative;
        max-width: 550px;
        margin-inline: auto;
        width: 100%;

        .green-shape {
          position: absolute;
          bottom: -20px;
          left: -20px;
          width: 140px;
          height: 140px;
          background-color: var(--color-ui-secondary, #bcf5b3);
          border-radius: 24px;
          z-index: 0;
        }

        .image-grid {
          position: relative;
          z-index: 1;
          display: grid;
          grid-template-columns: 1fr 1fr;
          grid-template-rows: auto auto;
          gap: 16px;

          img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 20px;
            display: block;
          }

          .img-tall {
            grid-column: 1 / 2;
            grid-row: 1 / 3;
            aspect-ratio: 3/4;
          }

          .img-top {
            grid-column: 2 / 3;
            grid-row: 1 / 2;
            aspect-ratio: 4/3;
          }

          .img-bottom {
            grid-column: 2 / 3;
            grid-row: 2 / 3;
            aspect-ratio: 4/3;
          }
        }
      }
    }
  }
</style>
