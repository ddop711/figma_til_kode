---
// src/components/Header.astro
import Button from "../components/Button.astro";
---

<header class="header">
  <div class="header-container">
    <a href="/" class="logo">AskExperts</a>

    <nav class="nav">
      <a href="/">Home</a>
      <a href="/case-studies/taxes-and-efficiency">Case Studies</a>
      <a href="/team">Team</a>
      <a href="/about">About</a>
    </nav>

    <!-- Trigger med Popover API -->
    <Button
      text="Login"
      color="var(--color-surface-primary)"
      popovertarget="login-popover"
      textColor="var(--color-neutrals-900)"
    />

    <!-- Popover panel -->
    <div id="login-popover" popover>
      <div class="popover-content">
        <h3>Sign In</h3>
        <p>Enter your credentials.</p>

        <form class="login-form" onsubmit="event.preventDefault()">
          <label>
            <span>Email</span>
            <input
              type="email"
              placeholder="mikkelstorm@example.com"
              required
            />
          </label>
          <label>
            <span>Password</span>
            <input type="password" placeholder="••••••••" required />
          </label>
          <button type="submit" class="submit-btn">Log In</button>
        </form>
      </div>
    </div>
  </div>
</header>

<style>
  .header {
    background-color: var(--color-ui-primary, #181818);
    color: var(--color-surface-primary, #ffffff);
    padding-block: var(--space-md, 1rem);
    padding-inline: var(--space-md, 1rem);
    width: 100%;
    position: relative;
    z-index: 100;
    box-sizing: border-box;

    @media (min-width: 900px) {
      padding-inline: var(--space-2xl, 2rem);
    }

    .header-container {
      max-width: 1200px;
      margin-inline: auto;
      display: flex;
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      width: 100%;

      .logo {
        font-size: var(--font-size-md, 1.25rem);
        font-family: var(--font-family-primary, serif);
        font-weight: 700;
        color: var(--color-surface-primary, #ffffff);
        text-decoration: none;
      }

      .nav {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: var(--space-lg, 1.5rem);

        a {
          color: var(--color-surface-primary, #ffffff);
          text-decoration: none;
          font-family: var(--font-family-secondary, sans-serif);
          font-size: var(--font-size-sm, 0.875rem);
          font-weight: 500;
          transition: color 0.2s ease;

          &:hover {
            color: var(--color-action, #ffcc4a);
          }
        }
      }

      .login-btn {
        background-color: var(--color-action, #ffcc4a);
        color: var(--color-ui-primary, #181818);
        font-family: var(--font-family-secondary, sans-serif);
        font-size: var(--font-size-sm, 0.875rem);
        font-weight: 600;
        padding: var(--space-xs, 0.5rem) var(--space-lg, 1.25rem);
        border-radius: var(--radius-pill, 9999px);
        border: none;
        cursor: pointer;
      }
    }
  }

  /* Popover container */
  #login-popover {
    border: 1px solid var(--color-neutrals-700, #333333);
    background-color: var(--color-ui-primary, #1e1e1e);
    color: var(--color-surface-primary, #ffffff);
    padding: var(--space-xl, 1.5rem);
    border-radius: var(--radius-md, 0.75rem);
    box-shadow: 0 16px 32px rgba(0, 0, 0, 0.4);
    width: min(340px, 90vw);
    box-sizing: border-box;

    top: var(--space-xl, 1.5rem);
    right: var(--space-xl, 1.5rem);
    bottom: auto;
    left: auto;
    margin: 0;

    .popover-content {
      display: flex;
      flex-direction: column;
      gap: var(--space-md, 1rem);

      h3 {
        margin: 0;
        font-family: var(--font-family-primary, serif);
        font-size: var(--font-size-lg, 1.25rem);
        color: #ffffff;
      }

      p {
        margin: 0;
        color: var(--color-text-weak, #a0a0a0);
        font-size: var(--font-size-sm, 0.875rem);
        line-height: var(--line-height-body, 1.4);
      }

      .login-form {
        display: flex;
        flex-direction: column;
        gap: var(--space-sm, 0.75rem);

        label {
          display: flex;
          flex-direction: column;
          gap: 4px;

          span {
            font-size: 0.75rem;
            color: var(--color-text-weak, #a0a0a0);
          }

          input {
            padding: var(--space-xs, 0.5rem) var(--space-sm, 0.75rem);
            background-color: var(--color-surface-elevated, #2a2a2a);
            border: 1px solid var(--color-neutrals-700, #404040);
            border-radius: var(--radius-sm, 0.375rem);
            color: #ffffff;
            font-size: var(--font-size-sm, 0.875rem);
            outline: none;

            &:focus {
              border-color: var(--color-action, #ffcc4a);
            }
          }
        }

        .submit-btn {
          margin-top: var(--space-xs, 0.5rem);
          background-color: var(--color-action, #ffcc4a);
          color: var(--color-ui-primary, #181818);
          border: none;
          padding: var(--space-xs, 0.5rem) var(--space-md, 1rem);
          border-radius: var(--radius-pill, 9999px);
          font-weight: 700;
          cursor: pointer;
        }
      }
    }
  }

  #login-popover::backdrop {
    background-color: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
</style>
