---
// src/components/Hero.astro
import { Image } from "astro:assets";
import Services from "./Services.astro";
import CEOImage from "@assets/images/ceo.webp";
---

<section class="hero-container">
  <div class="content">
    <div class="hero-grid">
      <div class="hero-content">
        <h1>Empowering Your Business Growth</h1>
        <p>
          Discover tailored strategies and expert insights to take your business
          to the next level. Let us help you navigate challenges and achieve
          sustainable success.
        </p>

        <div class="hero-buttons">
          <a href="#0" class="btn-primary">Book a Meeting</a>
          <a href="#0" class="btn-secondary">
            Learn More <span>&rarr;</span>
          </a>
        </div>
      </div>

      <div class="hero-image">
        <Image src={CEOImage} alt="CEO" />
      </div>
    </div>

    <div class="hero-services">
      <Services />
    </div>
  </div>
</section>

<style>
  .hero-container {
    background-color: var(--color-ui-primary, #0c111d);
    color: var(--color-surface-primary, #ffffff);
    padding-top: clamp(2.5rem, 5vw, 5rem);
    padding-inline: var(--space-md, 1.5rem);
    position: relative;

    margin-bottom: 5.5rem;

    .content {
      max-width: 1200px;
      margin-inline: auto;
      display: flex;
      flex-direction: column;
      gap: 3rem;

      .hero-grid {
        display: flex;
        flex-direction: column;
        gap: 2rem;

        .hero-content {
          width: 100%;

          h1 {
            font-size: clamp(2.25rem, 4vw, 3.5rem);
            font-family: var(--font-family-primary);
            line-height: 1.15;
            font-weight: 700;
            margin-bottom: 1.25rem;
          }

          p {
            font-size: 1rem;
            font-family: var(--font-family-secondary);
            line-height: 1.6;
            color: var(--color-text-weak, #9ca3af);
            margin-bottom: 2rem;
            max-width: 520px;
          }

          .hero-buttons {
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
            align-items: center;

            .btn-primary,
            .btn-secondary {
              display: inline-flex !important;
              align-items: center;
              justify-content: center;
              padding: 0.85rem 1.75rem !important;
              line-height: 1 !important;
              border-radius: 9999px;
              font-family: var(--font-family-secondary);
              font-weight: 600;
              font-size: 0.95rem;
              text-decoration: none;
              white-space: nowrap;
              box-sizing: border-box;
            }

            .btn-primary {
              background-color: var(--color-action, #f8c146);
              color: #111827;
              border: 1px solid var(--color-action, #f8c146);
            }

            .btn-secondary {
              background-color: transparent;
              color: #ffffff;
              border: 1px solid rgba(255, 255, 255, 0.25);
              gap: 0.5rem;
            }
          }
        }

        .hero-image {
          width: 100%;
          display: flex;
          justify-content: center;

          img {
            width: 100%;
            max-width: 480px;
            height: auto;
            object-fit: cover;
            border-radius: 1rem;
          }
        }
      }

      .hero-services {
        width: 100%;
        position: relative;
        z-index: 10;
        margin-bottom: -4.5rem;
      }

      @media (min-width: 900px) {
        .hero-grid {
          display: grid;
          grid-template-columns: 1.15fr 0.85fr;
          align-items: center;
          gap: 3rem;

          .hero-image {
            justify-content: flex-end;

            img {
              max-width: 100%;
            }
          }
        }
      }
    }

    @media (min-width: 900px) {
      padding-inline: var(--space-2xl, 2rem);
    }
  }
</style>
