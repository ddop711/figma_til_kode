---
// src/components/Expect.astro
import { Image } from "astro:assets";
import CaseImg from "@data/images/caseimg.webp";
import Checkmark from "@icons/checkmark.svg";
---

<section class="expect">
  <div class="container">
    <div class="media">
      <div class="box"></div>
      <Image src={CaseImg} alt="What to expect" />
    </div>

    <div class="text">
      <span class="tag">WE'LL WORK WITH YOU</span>
      <h2>What To Expect</h2>
      <p class="desc">
        Our collaboration is built on transparency, efficiency, and measurable
        results. Together, we create strategies tailored to your unique needs
        and goals.
      </p>

      <ul class="list">
        <li>
          <span class="icon">
            <Checkmark width={20} height={20} />
          </span>
          <p>
            Collaborate to build actionable strategies that drive sustainable
            growth and deliver tangible outcomes.
          </p>
        </li>
        <li>
          <span class="icon">
            <Checkmark width={20} height={20} />
          </span>
          <p>
            Identify opportunities to optimize processes and implement impactful
            solutions with measurable results.
          </p>
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  .expect {
    background-color: var(--color-surface-primary);
    color: var(--color-text);
    width: 100%;
    box-sizing: border-box;
    padding-top: var(--space-5xl);
    padding-bottom: var(--space-5xl);
    padding-inline: var(--space-md);

    @media (min-width: 900px) {
      padding-top: var(--space-6xl);
      padding-bottom: var(--space-6xl);
      padding-inline: var(--space-2xl);
    }

    .container {
      max-width: 1200px;
      margin-inline: auto;
      display: flex;
      flex-direction: column;
      gap: var(--space-3xl);

      @media (min-width: 900px) {
        flex-direction: row;
        align-items: center;
        gap: var(--space-5xl);
      }

      .media {
        position: relative;
        width: 100%;
        max-width: 480px;
        margin-inline: auto;

        @media (min-width: 900px) {
          flex: 1;
          margin: 0;
        }

        .box {
          position: absolute;
          top: calc(-1 * var(--space-md));
          left: calc(-1 * var(--space-md));
          width: 100px;
          height: 100px;
          background-color: var(--color-ui-secondary);
          border-radius: var(--radius-md);
          z-index: 1;

          @media (min-width: 900px) {
            top: calc(-1 * var(--space-lg));
            left: calc(-1 * var(--space-lg));
            width: 140px;
            height: 140px;
          }
        }

        img {
          position: relative;
          z-index: 2;
          width: 100%;
          height: auto;
          border-radius: var(--radius-md);
          object-fit: cover;
          display: block;
        }
      }

      .text {
        width: 100%;
        display: flex;
        flex-direction: column;

        @media (min-width: 900px) {
          flex: 1;
        }

        .tag {
          color: var(--color-ui-primary);
          font-size: var(--font-size-sm);
          font-family: var(--font-family-secondary);
          letter-spacing: 2px;
          font-weight: 700;
          text-transform: uppercase;
          margin-bottom: var(--space-xs);
        }

        h2 {
          font-size: var(--font-size-xl);
          font-family: var(--font-family-primary);
          font-weight: 700;
          line-height: var(--line-height-heading);
          margin-block: 0 var(--space-md);
          color: var(--color-text);

          @media (min-width: 900px) {
            font-size: var(--font-size-2xl);
          }
        }

        .desc {
          color: var(--color-text-muted);
          font-size: var(--font-size-base);
          font-family: var(--font-family-secondary);
          line-height: var(--line-height-body);
          margin-block: 0 var(--space-xl);
        }

        .list {
          display: flex;
          flex-direction: column;
          gap: var(--space-lg);
          list-style: none;
          padding: 0;
          margin: 0;

          li {
            display: flex;
            gap: var(--space-md);
            align-items: flex-start;

            .icon {
              display: flex;
              align-items: center;
              justify-content: center;
              flex-shrink: 0;
              margin-top: 2px;
            }

            p {
              color: var(--color-text);
              font-size: var(--font-size-base);
              font-family: var(--font-family-secondary);
              line-height: var(--line-height-body);
              margin: 0;
            }
          }
        }
      }
    }
  }
</style>
