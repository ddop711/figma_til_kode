---
// src/components/CoreValues.astro
import LayersIcon from "@icons/layers.svg";
import BarsIcon from "@icons/bars.svg";
import GlobeIcon from "@icons/globe.svg";
import GearIcon from "@icons/gear.svg";

const response = await fetch("https://ftk-api.pages.dev/core-values");
const data = await response.json();
---

<section class="core-values">
  <div class="container">
    <div class="header">
      <div class="text">
        <span>{data.eyebrow}</span>
        <h2>{data.title}</h2>
        <p>{data.subtitle}</p>
      </div>

      <a href={data.button.link} class="btn">{data.button.text}</a>
    </div>

    <div class="cards">
      <article class="card">
        <LayersIcon width={32} height={32} />
        <h3>{data.values[0].title}</h3>
        <p>{data.values[0].description}</p>
        <a href={data.values[0].link.url}
          >{data.values[0].link.text} <span>&rarr;</span></a
        >
      </article>

      <article class="card">
        <BarsIcon width={32} height={32} />
        <h3>{data.values[1].title}</h3>
        <p>{data.values[1].description}</p>
        <a href={data.values[1].link.url}
          >{data.values[1].link.text} <span>&rarr;</span></a
        >
      </article>

      <article class="card">
        <GlobeIcon width={32} height={32} />
        <h3>{data.values[2].title}</h3>
        <p>{data.values[2].description}</p>
        <a href={data.values[2].link.url}
          >{data.values[2].link.text} <span>&rarr;</span></a
        >
      </article>

      <article class="card">
        <GearIcon width={32} height={32} />
        <h3>{data.values[3].title}</h3>
        <p>{data.values[3].description}</p>
        <a href={data.values[3].link.url}
          >{data.values[3].link.text} <span>&rarr;</span></a
        >
      </article>
    </div>
  </div>
</section>

<style>
  .core-values {
    background-color: var(--color-ui-primary);
    color: var(--color-surface-primary);
    padding: var(--space-4xl) var(--space-lg);
    width: 100%;
    box-sizing: border-box;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
    box-sizing: border-box;
  }

  .header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-lg);
    margin-bottom: var(--space-3xl);
  }

  .header .text span {
    display: block;
    color: var(--color-action);
    font-size: var(--font-size-sm);
    letter-spacing: 2px;
    font-weight: 700;
    text-transform: uppercase;
    margin-bottom: var(--space-xs);
  }

  .header .text h2 {
    font-size: var(--font-size-xl);
    font-family: var(--font-family-primary);
    font-weight: 700;
    line-height: var(--line-height-heading);
    margin-bottom: var(--space-sm);
  }

  .header .text p {
    font-size: var(--font-size-base);
    color: var(--color-text-weak);
    line-height: var(--line-height-body);
  }

  .header .btn {
    background-color: var(--color-surface-primary);
    color: var(--color-ui-primary);
    font-weight: 600;
    font-size: var(--font-size-base);
    padding: var(--space-sm) var(--space-xl);
    border-radius: var(--radius-pill);
    text-decoration: none;
    white-space: nowrap;
  }

  /* MOBIL */
  .cards {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    width: 100%;
  }

  .card {
    width: 100%;
    background-color: var(--color-surface-primary);
    color: var(--color-text);
    padding: var(--space-2xl);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
  }

  .card svg {
    color: var(--color-ui-primary);
    margin-bottom: var(--space-lg);
  }

  .card h3 {
    font-size: var(--font-size-md);
    font-family: var(--font-family-primary);
    font-weight: 700;
    line-height: var(--line-height-heading);
    margin-bottom: var(--space-xs);
  }

  .card p {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    line-height: var(--line-height-body);
    margin-bottom: var(--space-lg);
  }

  .card a {
    color: var(--color-text);
    font-size: var(--font-size-sm);
    font-weight: 700;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
  }

  /* TABLET */
  @media (min-width: 650px) {
    .cards {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-xl);
    }
  }

  /* DESKTOP */
  @media (min-width: 1024px) {
    .core-values {
      padding: var(--space-6xl) var(--space-xl);
    }

    .header {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
      margin-bottom: var(--space-4xl);
    }

    .header .text {
      max-width: 600px;
    }

    .cards {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
