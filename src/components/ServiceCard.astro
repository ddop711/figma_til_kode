---
const { service } = Astro.props;
import ArrowRight from "@icons/arrow--right.svg";
---

<article class="service-card">
  <div class="card-text">
    <h3>{service.title}</h3>
    <p>{service.description}</p>
  </div>
  <a href="#0">
    {service.buttonText || "Explore"}
    {ArrowRight ? <ArrowRight /> : <span>&rarr;</span>}
  </a>
</article>

<style>
  .service-card {
    container-type: inline-size;
    container-name: card;

    background: var(--color-surface-elevated-transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(234, 237, 241, 0.1);
    color: var(--color-on-surface-elevated);
    padding: var(--space-xl);
    border-radius: var(--radius-md);
    box-shadow: 0 20px 30px -10px rgba(3, 7, 18, 0.35);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-lg);
    box-sizing: border-box;
    width: 100%;

    .card-text {
      display: flex;
      flex-direction: column;
      gap: var(--space-xs);

      h3 {
        font-family: var(--font-family-primary);
        font-size: var(--font-size-base);
        font-weight: 700;
        line-height: var(--line-height-heading);
        margin: 0;
        color: var(--color-on-surface-elevated);
      }

      p {
        font-family: var(--font-family-secondary);
        font-size: var(--font-size-sm);
        line-height: var(--line-height-body);
        color: var(--color-text-weak);
        margin: 0;
      }
    }

    a {
      display: inline-flex;
      align-items: center;
      gap: var(--space-xs);
      color: var(--color-action);
      font-family: var(--font-family-secondary);
      font-weight: 600;
      font-size: var(--font-size-sm);
      text-decoration: none;
      width: fit-content;

      svg {
        width: 16px;
        height: 16px;
      }
    }

    @container card (min-width: 320px) {
      padding: var(--space-2xl);
      gap: var(--space-xl);

      .card-text {
        gap: var(--space-sm);

        h3 {
          font-size: var(--font-size-md);
        }

        p {
          font-size: var(--font-size-base);
        }
      }

      a {
        font-size: var(--font-size-base);
      }
    }
  }
</style>
