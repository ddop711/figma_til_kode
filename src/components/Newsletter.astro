---
// src/components/Newsletter.astro
---

<section class="newsletter">
  <div class="newsletter-container">
    <span class="eyebrow">STAY UPDATED</span>
    <h2 class="title">Subscribe Our Newsletter</h2>
    <p class="desc">
      Build stronger Customer Relationships with <span>Consultalk</span>
    </p>

    <form class="form" onsubmit="event.preventDefault()">
      <input type="email" placeholder="your mail address" required />
      <button type="submit">Subscribe</button>
    </form>
  </div>
</section>

<style>
  .newsletter {
    background-color: var(--color-ui-primary, #181818);
    color: var(--color-surface-primary, #ffffff);
    padding-block: var(--space-5xl, 80px);
    padding-inline: var(--space-md, 16px);
    width: 100%;
    display: flex;
    justify-content: center;
    box-sizing: border-box;

    .newsletter-container {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      width: 100%;
      max-width: 600px;
      margin: 0 auto;

      .eyebrow {
        color: var(--color-action, #ffcc4a);
        font-size: var(--font-size-sm, 14px);
        font-family: var(--font-family-secondary, sans-serif);
        letter-spacing: 2px;
        font-weight: 700;
        text-transform: uppercase;
        margin-bottom: var(--space-xs, 8px);
        display: block;
      }

      .title {
        font-size: var(--font-size-2xl, 36px);
        font-family: var(--font-family-primary, serif);
        line-height: var(--line-height-heading, 1.2);
        font-weight: 700;
        margin: 0 0 var(--space-xs, 8px) 0;
        color: var(--color-surface-primary, #ffffff);
      }

      .desc {
        color: var(--color-surface-tertiary, #cccccc);
        font-size: var(--font-size-base, 16px);
        font-family: var(--font-family-secondary, sans-serif);
        line-height: var(--line-height-body, 1.5);
        margin: 0 0 var(--space-2xl, 32px) 0;

        span {
          color: var(--color-action, #ffcc4a);
          font-weight: 600;
        }
      }

      .form {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: center;
        gap: var(--space-md, 16px);
        width: 100%;
        max-width: 480px;

        input {
          flex: 1;
          background-color: transparent;
          border: 1px solid var(--color-surface-tertiary, #404040);
          border-radius: var(--radius-pill, 9999px);
          padding-block: var(--space-sm, 14px);
          padding-inline: var(--space-xl, 24px);
          color: var(--color-surface-primary, #ffffff);
          font-size: var(--font-size-base, 16px);
          font-family: var(--font-family-secondary, sans-serif);
          outline: none;
          box-sizing: border-box;

          &::placeholder {
            color: var(--color-text-weak, #888888);
          }
        }

        button {
          background-color: var(--color-action, #ffcc4a);
          color: var(--color-ui-primary, #181818);
          border: none;
          border-radius: var(--radius-pill, 9999px);
          padding-block: var(--space-sm, 14px);
          padding-inline: var(--space-2xl, 32px);
          font-size: var(--font-size-base, 16px);
          font-family: var(--font-family-secondary, sans-serif);
          font-weight: 700;
          cursor: pointer;
          white-space: nowrap;
        }
      }
    }
  }
</style>
