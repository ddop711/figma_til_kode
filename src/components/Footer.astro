---

---

<footer>
  <div class="container">
    <div class="logo">
      <a href="/">Ask<span>Experts</span></a>
    </div>
    <p class="copyright">©2026 Consultalk. All rights reserved</p>
    <div class="links">
      <a href="#">Terms of Service</a> | <a href="#">Privacy Policy</a>
    </div>
  </div>
</footer>

<style>
  footer {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    background-color: var(--color-ui-primary);
    padding-block: var(--space-2xl);
    border-top: 1px solid rgba(234, 237, 241, 0.1);
  }

  .container {
    grid-column: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    text-align: center;
  }

  .logo a {
    color: var(--color-surface-primary);
    text-decoration: none;
    font-size: var(--font-size-lg);
    font-weight: bold;
  }
  .logo span {
    color: var(--color-action);
  }

  .copyright,
  .links {
    color: var(--color-surface-tertiary);
    font-size: var(--font-size-sm);
    margin: 0;
  }

  .links a {
    color: var(--color-surface-tertiary);
    text-decoration: none;
  }
  .links a:hover {
    color: var(--color-action);
  }

  @media (min-width: 900px) {
    .container {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }
</style>
