---
const response = await fetch("https://ftk-api.pages.dev/experience");
const data = await response.json();
---

<section class="experience">
  <div class="container">
    <div class="info">
      <span class="eyebrow">{data.eyebrow}</span>
      <h2 class="title">{data.title}</h2>
      <p class="desc">{data.subtitle}</p>
    </div>

    <div class="stats">
      <div class="stat-item">
        <div class="circle dot-1">
          <span class="value">{data.stats[0].value}%</span>
        </div>
        <p class="label">{data.stats[0].label}</p>
      </div>

      <div class="stat-item">
        <div class="circle dot-2">
          <span class="value">{data.stats[1].value}%</span>
        </div>
        <p class="label">{data.stats[1].label}</p>
      </div>

      <div class="stat-item">
        <div class="circle dot-3">
          <span class="value">{data.stats[2].value}%</span>
        </div>
        <p class="label">{data.stats[2].label}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .experience {
    background-color: var(--color-action, #ffcc4a);
    color: var(--color-ui-primary, #181818);
    padding: var(--space-6xl, 128px) var(--space-md, 16px);
    width: 100%;
    overflow: hidden;

    .container {
      max-width: 1200px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: var(--space-4xl, 48px);

      @media (min-width: 1024px) {
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
      }

      .info {
        max-width: 420px;

        .eyebrow {
          display: block;
          font-size: var(--font-size-sm, 14px);
          font-weight: 700;
          letter-spacing: 2px;
          text-transform: uppercase;
          margin-bottom: var(--space-xs, 8px);
        }

        .title {
          font-size: var(--font-size-xl, 36px);
          font-family: var(--font-family-primary, serif);
          font-weight: 700;
          line-height: var(--line-height-heading, 1.2);
          margin: 0 0 var(--space-sm, 16px) 0;
        }

        .desc {
          font-size: var(--font-size-base, 16px);
          line-height: var(--line-height-body, 1.6);
          margin: 0;
        }
      }

      .stats {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--space-3xl, 32px);
        width: 100%;

        @media (min-width: 600px) {
          flex-direction: row;
          justify-content: center;
          flex-wrap: wrap;
        }

        @media (min-width: 1024px) {
          justify-content: flex-end;
        }

        .stat-item {
          display: flex;
          flex-direction: column;
          align-items: center;
          gap: var(--space-md, 16px);

          .circle {
            position: relative;
            width: 120px;
            height: 120px;
            border-radius: var(--radius-pill, 50%);
            border: 3px solid var(--color-surface-primary, #ffffff);

            display: flex;
            align-items: center;
            justify-content: center;

            .value {
              font-size: var(--font-size-xl, 32px);
              font-family: var(--font-family-primary, serif);
              font-weight: 700;
            }

            &::after {
              content: "";
              position: absolute;
              width: var(--space-md, 16px);
              height: var(--space-md, 16px);
              background-color: var(--color-ui-primary, #181818);
              border: 2px solid var(--color-surface-primary, #ffffff);
              border-radius: var(--radius-pill, 50%);
            }

            &.dot-1::after {
              top: 12px;
              left: 8px;
            }
            &.dot-2::after {
              top: -8px;
              left: 48px;
            }
            &.dot-3::after {
              top: 12px;
              right: 8px;
            }
          }

          .label {
            font-weight: 700;
            font-size: var(--font-size-base, 16px);
            line-height: var(--line-height-body, 1.6);
            margin: 0;
            text-align: center;
          }
        }
      }
    }
  }
</style>
