---
const response = await fetch("https://ftk-api.pages.dev/experience");
const data = await response.json();
---

<section class="experience">
  <div class="container">
    <div class="info">
      <span class="eyebrow">{data.eyebrow}</span>
      <h2 class="title">{data.title}</h2>
      <p class="desc">{data.subtitle}</p>
    </div>

    <div class="stats" scroll-trigger>
      {data.stats.map((stat) => (
        <div class="stat-item">
          <div
            class="stat"
            style={`--percent: ${Math.min(100, Math.max(0, Number(stat.value) || 0))}`}
          ></div>
          <p class="label">{stat.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .experience {
    background-color: var(--color-action);
    color: var(--color-ui-primary);
    padding-block: var(--space-5xl);
    padding-inline: var(--space-md);
    width: 100%;
    box-sizing: border-box;

    @media (min-width: 1024px) {
      padding-block: var(--space-6xl);
      padding-inline: var(--space-2xl);
    }
  }

  .container {
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-3xl);

    @media (min-width: 1024px) {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .info {
    max-width: 440px;
  }

  .eyebrow {
    display: block;
    font-size: var(--font-size-sm);
    font-family: var(--font-family-secondary);
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: var(--space-xs);
  }

  .title {
    font-size: var(--font-size-xl);
    font-family: var(--font-family-primary);
    font-weight: 700;
    line-height: var(--line-height-heading);
    margin-block: 0 var(--space-sm);
  }

  .desc {
    font-size: var(--font-size-base);
    font-family: var(--font-family-secondary);
    line-height: var(--line-height-body);
    margin: 0;
  }

  .stats {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2xl);
    width: 100%;

    @media (min-width: 600px) {
      flex-direction: row;
      justify-content: center;
      gap: var(--space-3xl);
    }

    @media (min-width: 1024px) {
      justify-content: flex-end;
    }
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
  }

  .stat {
    --animatedNumber: calc(var(--percent) * var(--sentinel));
    --actualPercent: calc(var(--animatedNumber) * 1%);
    --border-width: 4px;
    --track-color: color-mix(in srgb, var(--color-ui-primary) 18%, transparent);

    aspect-ratio: 1;
    width: 130px;
    border-radius: calc(infinity * 1px);
    border: var(--border-width) solid transparent;
    box-sizing: border-box;

    background:
      conic-gradient(var(--color-action) 0 0) padding-box,
      radial-gradient(
          circle at calc(50% + 0.5px) calc(var(--border-width) / 2),
          var(--color-surface-primary) calc(var(--border-width) / 2),
          transparent 0
        )
        border-box,
      conic-gradient(
          var(--color-surface-primary) var(--actualPercent),
          var(--track-color) 0
        )
        border-box;

    display: grid;
    counter-reset: c round(nearest, var(--animatedNumber), 1);
  }

  .stat::before,
  .stat::after {
    grid-area: 1 / 1;
  }

  .stat::after {
    content: counter(c) "%";
    place-self: center;
    font-size: var(--font-size-xl);
    font-family: var(--font-family-primary);
    font-weight: 700;
    line-height: 1;
    color: var(--color-ui-primary);
    font-variant-numeric: tabular-nums;
    position: relative;
    z-index: 2;
  }

  .stat::before {
    content: "";
    aspect-ratio: 1;
    border-radius: 99px;
    width: 18px;
    box-sizing: border-box;
    background: var(--color-ui-primary);
    border: 3.5px solid var(--color-surface-primary);
    z-index: 3;

    offset-path: border-box;
    offset-distance: var(--actualPercent);
    offset-anchor: 50% calc(50% - var(--border-width) / 2);
  }

  .stat-item .label {
    font-family: var(--font-family-secondary);
    font-weight: 700;
    font-size: var(--font-size-base);
    margin: 0;
    text-align: center;
  }
</style>
