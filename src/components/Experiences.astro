---
const response = await fetch("https://ftk-api.pages.dev/experience");
const data = await response.json();
---

<section class="experience">
  <div class="container">
    <div class="info">
      <span class="eyebrow">{data.eyebrow}</span>
      <h2 class="title">{data.title}</h2>
      <p class="desc">{data.subtitle}</p>
    </div>

    <div class="stats">
      <div class="stat-item">
        <div class="circle dot-85">
          <span class="value">{data.stats[0].value}%</span>
        </div>
        <p class="label">{data.stats[0].label}</p>
      </div>

      <div class="stat-item">
        <div class="circle dot-95">
          <span class="value">{data.stats[1].value}%</span>
        </div>
        <p class="label">{data.stats[1].label}</p>
      </div>

      <div class="stat-item">
        <div class="circle dot-90">
          <span class="value">{data.stats[2].value}%</span>
        </div>
        <p class="label">{data.stats[2].label}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .experience {
    background-color: var(--color-action);
    color: var(--color-ui-primary);
    padding-block: var(--space-5xl);
    padding-inline: var(--space-md);
    width: 100%;
    box-sizing: border-box;

    @media (min-width: 1024px) {
      padding-block: var(--space-6xl);
      padding-inline: var(--space-2xl);
    }

    .container {
      max-width: 1200px;
      margin-inline: auto;
      display: flex;
      flex-direction: column;
      gap: var(--space-3xl);

      @media (min-width: 1024px) {
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
      }

      .info {
        max-width: 440px;

        .eyebrow {
          display: block;
          font-size: var(--font-size-sm);
          font-family: var(--font-family-secondary);
          font-weight: 700;
          letter-spacing: 2px;
          text-transform: uppercase;
          margin-bottom: var(--space-xs);
        }

        .title {
          font-size: var(--font-size-xl);
          font-family: var(--font-family-primary);
          font-weight: 700;
          line-height: var(--line-height-heading);
          margin-block: 0 var(--space-sm);
        }

        .desc {
          font-size: var(--font-size-base);
          font-family: var(--font-family-secondary);
          line-height: var(--line-height-body);
          margin: 0;
        }
      }

      .stats {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--space-2xl);
        width: 100%;

        @media (min-width: 600px) {
          flex-direction: row;
          justify-content: center;
          gap: var(--space-3xl);
        }

        @media (min-width: 1024px) {
          justify-content: flex-end;
        }

        .stat-item {
          display: flex;
          flex-direction: column;
          align-items: center;
          gap: var(--space-md);

          .circle {
            position: relative;
            width: 130px;
            height: 130px;
            aspect-ratio: 1 / 1;
            border-radius: 50%;
            border: 3.5px solid var(--color-surface-primary);
            box-sizing: border-box;
            display: flex;
            align-items: center;
            justify-content: center;

            .value {
              font-size: var(--font-size-xl);
              font-family: var(--font-family-primary);
              font-weight: 700;
            }

            &::after {
              content: "";
              position: absolute;
              width: var(--space-md);
              height: var(--space-md);
              background-color: var(--color-ui-primary);
              border: 2.5px solid var(--color-surface-primary);
              border-radius: 50%;
              box-sizing: border-box;
              transform: translate(-50%, -50%);
            }

            &.dot-85::after {
              top: 20%;
              left: 9%;
            }

            &.dot-95::after {
              top: 2%;
              left: 35%;
            }

            &.dot-90::after {
              top: 9%;
              left: 20%;
            }
          }

          .label {
            font-family: var(--font-family-secondary);
            font-weight: 700;
            font-size: var(--font-size-base);
            margin: 0;
            text-align: center;
          }
        }
      }
    }
  }
</style>
