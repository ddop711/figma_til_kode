---
import "@styles/main.css";
import { Font } from "astro:assets";
import Header from "../components/Header.astro";
import Newsletter from "../components/Newsletter.astro";
import Footer from "../components/Footer.astro";
const { title = "" } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/my-favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <Font cssVariable="--font-cabin" preload />
    <Font cssVariable="--font-lato" preload />
    <style is:inline>
      @layer reset, global, tokens, components, overrides;
    </style>
  </head>
  <body>
    <Header />
    <main class="page-grid">
      <slot />
    </main>
    <Newsletter />
    <Footer />
  </body>
</html>

<style>
  :global(*, *::before, *::after) {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :global(html) {
    /* overflow-x: clip forhindrer vandret scroll uden at ødelægge scroll-timeline */
    overflow-x: clip;
  }

  :global(body) {
    width: 100%;
    background-color: var(--color-surface-primary);
    font-family: var(--font-family-secondary);
  }

  .page-grid {
    display: grid;
    grid-template-columns:
      [full-start] minmax(var(--space-md), 1fr)
      [content-start] min(100% - (var(--space-md) * 2), 1200px) [content-end]
      minmax(var(--space-md), 1fr) [full-end];
  }

  @media (min-width: 900px) {
    .page-grid {
      grid-template-columns:
        [full-start] minmax(var(--space-2xl), 1fr)
        [content-start] min(100% - (var(--space-2xl) * 2), 1200px) [content-end]
        minmax(var(--space-2xl), 1fr) [full-end];
    }
  }

  .page-grid > :global(section) {
    grid-column: full;
    display: grid;
    grid-template-columns: subgrid;
  }

  .page-grid > :global(section > *) {
    grid-column: content;
  }

  @keyframes fade-in-up {
    from {
      opacity: 0;
      transform: translateY(60px);
      filter: blur(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0px);
    }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .page-grid > :global(section:not(.hero-container) > *) {
        animation-name: fade-in-up;
        animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 15% cover 35%;
      }
    }
  }
</style>
